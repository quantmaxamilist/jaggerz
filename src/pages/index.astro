---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import LogoMark from '../components/LogoMark.astro';
import logo1 from '../assets/images/logo1.jpg';
import food1 from '../assets/images/food1.jpg';
import food2 from '../assets/images/food2.jpg';
import milkshake1 from '../assets/images/milkshake1.jpg';
import pizza1 from '../assets/images/pizza1.jpg';
import mediaPhoto from '../assets/images/media-photo.jpg';
import front1 from '../assets/images/front1.jpg';
import outside1 from '../assets/images/outside1.jpg';
import outside2 from '../assets/images/outside2.jpg';

const marqueeText =
  'FRESH DAILY · HOMEMADE COUSCOUS · MADE TO ORDER · 7:30AM START · 16 PICTON TERRACE · FOLLOW @JAGGERZ.NARBERTH';

const signatureCallouts = [
  { label: 'Homemade Couscous', x: '8%', y: '18%' },
  { label: 'Fresh Salad', x: '72%', y: '8%' },
  { label: 'Pesto Chicken', x: '78%', y: '42%' },
  { label: 'Fluffy Sweet Potato', x: '62%', y: '78%' },
  { label: 'Coleslaw', x: '6%', y: '62%' },
];

const galleryItems = [
  { src: food1, alt: 'Sweet potato box with couscous, pesto chicken and salad' },
  { src: food2, alt: 'Granola and Greek yoghurt bowl with fresh fruit' },
  { src: milkshake1, alt: 'Branded Jaggerz milkshake' },
  { src: pizza1, alt: 'Pizza slices — margherita, fresh veg, BBQ chicken, pepperoni' },
  { src: mediaPhoto, alt: 'Sweet Potato Box breakdown' },
  { src: front1, alt: 'Jaggerz Takeaway storefront on Picton Terrace' },
  { src: outside1, alt: 'Homemade Oreo cheesecake at the outdoor seating area' },
];

const reviews = [
  {
    name: 'Kieran Jennings',
    text: "Best breakfast wrap I've ever had, 10/10 experience, will be back for the sweet jacket potato!",
  },
  {
    name: 'George Rizzardini',
    text: 'Called in on our way past by chance. Crisp, clean & good staff attitude, they work as a team. Excellent salad bowl at good value. We really did enjoy our meal on the beach.',
    meta: 'Food 5/5, Service 5/5, Atmosphere 4/5',
  },
  {
    name: 'Rheinallt George',
    text: 'Food was great and service was great. Also the coffee was really good.',
  },
  {
    name: 'Leanne R (Local Guide)',
    text: 'Great lunch, will come again. Nice to have some slightly unusual options eg baked sweet potato.',
  },
];

const stats = [
  { target: 5.0, label: 'Google Rating', suffix: '★', decimals: 1 },
  { target: 9, label: 'Reviews', suffix: '', decimals: 0 },
  { target: 730, label: 'Daily Start', suffix: '', display: '7:30AM', decimals: 0 },
  { target: 6, label: 'Days a Week', suffix: '', decimals: 0 },
];

const currentYear = new Date().getFullYear();
---

<Layout ogImage="/og-food1.jpg">

  <!-- PROMO BAR -->
  <div id="promo-bar" class="fixed top-0 left-0 right-0 z-[120] bg-ink text-cream text-center py-2.5 px-4 text-xs font-mono tracking-wider">
    <span id="promo-message" class="text-cream">
      Any Hot Drink & a Pastry — <span class="text-rust font-semibold">£5</span>
    </span>
    <span class="mx-3 text-cream/30">|</span>
    <a href="tel:07904709325" data-hover class="text-rust hover:text-cream transition-colors">07904 709325</a>
    <span class="mx-3 text-cream/30">|</span>
    <span id="hours-today" class="text-cream/80">Open today 7:30am–2:30pm</span>
  </div>

  <!-- NAV -->
  <nav id="site-nav" class="fixed top-[37px] left-0 right-0 z-[110] transition-colors duration-300">
    <div class="nav-inner mx-auto flex h-[68px] max-w-[1400px] items-center justify-between px-5 md:px-10">
      <a href="#hero" data-hover class="flex shrink-0 items-center">
        <LogoMark />
      </a>

      <div id="nav-desktop" class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-7 md:flex">
        <a href="#menu" data-hover class="nav-link text-xs font-medium uppercase tracking-widest text-cream/70 transition hover:text-cream">Menu</a>
        <a href="#menu" data-tab="breakfast" data-hover class="nav-link menu-nav-tab text-xs font-medium uppercase tracking-widest text-cream/70 transition hover:text-cream">Breakfast</a>
        <a href="#gallery" data-hover class="nav-link text-xs font-medium uppercase tracking-widest text-cream/70 transition hover:text-cream">Gallery</a>
        <a href="#reviews" data-hover class="nav-link text-xs font-medium uppercase tracking-widest text-cream/70 transition hover:text-cream">Reviews</a>
        <a href="#find-us" data-hover class="nav-link text-xs font-medium uppercase tracking-widest text-cream/70 transition hover:text-cream">Find Us</a>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="tel:07904709325"
          data-magnetic
          data-hover
          class="hidden rounded-sm bg-rust px-5 py-2.5 text-xs font-semibold uppercase tracking-wider text-cream transition hover:bg-rust/90 sm:inline-block"
        >
          Call Now
        </a>
        <button
          id="hamburger"
          type="button"
          aria-label="Open menu"
          class="flex h-11 w-11 flex-col items-center justify-center gap-1.5 rounded-sm border border-cream/20 md:hidden"
        >
          <span class="block h-0.5 w-5 bg-cream"></span>
          <span class="block h-0.5 w-5 bg-cream"></span>
          <span class="block h-0.5 w-5 bg-cream"></span>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden flex-col border-t border-cream/10 bg-ink md:hidden">
      <a href="#menu" class="mobile-link border-b border-cream/10 px-6 py-4 text-sm uppercase tracking-widest text-cream/80">Menu</a>
      <a href="#menu" data-tab="breakfast" class="mobile-link menu-nav-tab border-b border-cream/10 px-6 py-4 text-sm uppercase tracking-widest text-cream/80">Breakfast</a>
      <a href="#gallery" class="mobile-link border-b border-cream/10 px-6 py-4 text-sm uppercase tracking-widest text-cream/80">Gallery</a>
      <a href="#reviews" class="mobile-link border-b border-cream/10 px-6 py-4 text-sm uppercase tracking-widest text-cream/80">Reviews</a>
      <a href="#find-us" class="mobile-link border-b border-cream/10 px-6 py-4 text-sm uppercase tracking-widest text-cream/80">Find Us</a>
      <a href="tel:07904709325" class="px-6 py-4 text-sm font-semibold uppercase tracking-widest text-rust">Call Now — 07904 709325</a>
    </div>
  </nav>

  <!-- HERO -->
  <section id="hero" class="relative min-h-svh overflow-hidden bg-ink pt-[105px]">

    <div class="relative z-10 mx-auto grid min-h-[calc(100svh-105px)] max-w-[1400px] items-center gap-10 px-5 pb-16 md:grid-cols-2 md:px-10">
      <div class="flex flex-col justify-center">
        <Image
          id="hero-logo"
          src={logo1}
          alt=""
          width={180}
          height={72}
          class="mb-8 h-16 w-auto object-contain opacity-90"
        />
        <h1 id="hero-headline" class="font-display text-[clamp(2.75rem,7vw,5rem)] font-black leading-[0.95] tracking-tight text-cream">
          Fresh. Fast. Made Right Here.
        </h1>
        <p id="hero-sub" class="mt-6 max-w-lg text-base leading-relaxed text-cream/65">
          Jacket potatoes, salad boxes, pizza slices and breakfast rolls — built to order from 7:30am at 16 Picton Terrace, Narberth. Grab it to go, or take a seat outside.
        </p>
        <div id="hero-cta" class="mt-8">
          <a
            href="#menu"
            data-magnetic
            data-hover
            class="inline-block rounded-sm bg-rust px-8 py-4 text-sm font-semibold uppercase tracking-wider text-cream transition hover:bg-rust/90"
          >
            View Menu
          </a>
        </div>
      </div>

      <div id="hero-image-wrap" class="relative flex justify-end">
        <Image
          id="hero-image"
          src={food1}
          alt="Sweet potato box with homemade couscous, pesto chicken and fresh salad"
          width={700}
          height={700}
          loading="eager"
          class="hero-float relative z-10 w-full max-w-[560px] rounded-sm object-cover shadow-2xl"
        />
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="overflow-hidden border-y border-rust/15 bg-cream py-3.5">
    <div class="marquee-track">
      {
        [...Array(4)].flatMap(() =>
          marqueeText.split(' · ').map((item) => (
            <span class="inline-flex items-center gap-12 px-6 font-mono text-[11px] uppercase tracking-[0.18em] text-rust whitespace-nowrap">
              {item}
              <span class="text-rust/30">·</span>
            </span>
          ))
        )
      }
    </div>
  </div>

  <!-- SUPPLIER CREDIT -->
  <div class="bg-stone px-5 py-4 text-center">
    <p class="text-xs font-medium uppercase tracking-[0.14em] text-ink/55">
      Meat locally sourced from Andrew Rees & Sons · Coffee roasted by Cardigan Bay Roasters
    </p>
  </div>

  <!-- SIGNATURE FEATURE -->
  <section id="signature" class="section-reveal bg-stone px-5 py-24 md:px-10 md:py-32">
    <div class="mx-auto grid max-w-[1400px] items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="relative">
        <Image
          src={food1}
          alt="Sweet Potato Box"
          width={800}
          height={800}
          loading="lazy"
          class="w-full rounded-sm object-cover shadow-lg"
        />
      </div>

      <div class="relative lg:min-h-[420px]">
        <p class="mb-3 font-mono text-[10px] uppercase tracking-[0.2em] text-rust">Signature Box</p>
        <h2 class="font-display text-[clamp(2rem,4vw,3.25rem)] font-bold leading-tight text-ink">
          The Sweet Potato Box
        </h2>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-ink/65">
          Built fresh to order — fluffy sweet potato loaded with homemade couscous, pesto chicken, crisp salad and coleslaw. Everything in one box, ready when you are.
        </p>

        <ul class="mt-8 flex flex-wrap gap-2 lg:hidden">
          {
            signatureCallouts.map((c) => (
              <li class="signature-callout rounded-sm border border-rust/20 bg-cream px-3 py-2 text-xs font-medium text-rust">{c.label}</li>
            ))
          }
        </ul>

        <div class="relative mt-8 hidden min-h-[320px] lg:block">
          <svg class="pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {
              signatureCallouts.map((c) => (
                <line
                  x1="50"
                  y1="50"
                  x2={c.x.replace('%', '')}
                  y2={c.y.replace('%', '')}
                  stroke="#c5622b"
                  stroke-opacity="0.35"
                  stroke-width="0.3"
                  stroke-dasharray="1 1"
                />
              ))
            }
          </svg>

          {
            signatureCallouts.map((c) => (
              <div
                class="signature-callout absolute rounded-sm border border-rust/20 bg-cream/90 px-3 py-2 text-xs font-medium text-rust shadow-sm backdrop-blur-sm"
                style={`left:${c.x};top:${c.y};transform:translate(-50%,-50%)`}
              >
                {c.label}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- MENU -->
  <section id="menu" class="section-reveal bg-cream px-5 py-24 md:px-10 md:py-32">
    <div class="mx-auto max-w-[1100px]">
      <p class="mb-3 font-mono text-[10px] uppercase tracking-[0.2em] text-rust">Order Fresh</p>
      <h2 class="font-display text-[clamp(2.25rem,5vw,4rem)] font-bold text-ink">Menu</h2>
      <p class="mt-3 max-w-xl text-sm text-ink/60">Made fresh to order — build your box, grab your baguette, or pick a spot outside and stay a while.</p>

      <div class="mt-10 flex flex-wrap gap-6 border-b border-ink/10 sm:gap-8">
        <button type="button" data-menu-tab="breakfast" class="menu-tab active border-b-2 border-transparent pb-3 text-sm font-semibold uppercase tracking-wider text-ink/50 transition">
          Breakfast
        </button>
        <button type="button" data-menu-tab="lunch" class="menu-tab border-b-2 border-transparent pb-3 text-sm font-semibold uppercase tracking-wider text-ink/50 transition">
          Lunch
        </button>
        <button type="button" data-menu-tab="drinks" class="menu-tab border-b-2 border-transparent pb-3 text-sm font-semibold uppercase tracking-wider text-ink/50 transition">
          Drinks
        </button>
      </div>

      <!-- BREAKFAST -->
      <div id="menu-breakfast" class="menu-panel active mt-10 space-y-10">
        <p class="font-mono text-xs uppercase tracking-widest text-rust">Served 7:30am–11:30am</p>

        <div class="grid gap-6 md:grid-cols-3">
          <article class="rounded-sm border border-ink/8 bg-stone/50 p-6">
            <h3 class="font-display text-xl font-bold text-ink">Bap / Wrap</h3>
            <p class="mt-2 text-xs text-ink/55">Bacon, Sausage/Veggie Sausage, Egg</p>
            <ul class="mt-4 space-y-2 text-sm">
              <li class="flex justify-between gap-4"><span>1 item</span><span class="font-mono text-rust shrink-0">£5.00</span></li>
              <li class="flex justify-between gap-4"><span>2 item</span><span class="font-mono text-rust shrink-0">£5.50</span></li>
              <li class="flex justify-between gap-4"><span>3 item</span><span class="font-mono text-rust shrink-0">£6.00</span></li>
              <li class="text-ink/55 text-xs pt-1">Add hash brown or additional items — 50p each</li>
            </ul>
          </article>

          <article class="rounded-sm border border-ink/8 bg-stone/50 p-6">
            <h3 class="font-display text-xl font-bold text-ink">Baguette</h3>
            <p class="mt-2 text-xs text-ink/55">Bacon, Sausage/Veggie Sausage, Egg</p>
            <ul class="mt-4 space-y-2 text-sm">
              <li class="flex justify-between gap-4"><span>1 item</span><span class="font-mono text-rust shrink-0">£5.50</span></li>
              <li class="flex justify-between gap-4"><span>2 item</span><span class="font-mono text-rust shrink-0">£6.00</span></li>
              <li class="flex justify-between gap-4"><span>3 item</span><span class="font-mono text-rust shrink-0">£6.50</span></li>
              <li class="text-ink/55 text-xs pt-1">Add hash brown or additional items — 50p each</li>
            </ul>
          </article>

          <article class="rounded-sm border border-ink/8 bg-stone/50 p-6">
            <h3 class="font-display text-xl font-bold text-ink">Breakfast Box</h3>
            <p class="mt-2 text-xs text-ink/55">Sausage/Veggie Sausage, Bacon, Egg, Hash Brown, Beans, Mushrooms & Toast</p>
            <ul class="mt-4 space-y-2 text-sm">
              <li class="flex justify-between gap-4"><span>Regular</span><span class="font-mono text-rust shrink-0">£7.95</span></li>
              <li class="flex justify-between gap-4"><span>Large</span><span class="font-mono text-rust shrink-0">£10.00</span></li>
              <li class="text-ink/55 text-xs pt-1">Add extras — 50p each</li>
            </ul>
          </article>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          <article class="rounded-sm border border-ink/8 p-6">
            <h3 class="font-display text-lg font-bold text-ink">Pastries</h3>
            <ul class="mt-3 space-y-2 text-sm">
              <li class="flex justify-between"><span>Croissant</span><span class="font-mono text-rust">£2.00</span></li>
              <li class="flex justify-between"><span>Pain au Chocolat</span><span class="font-mono text-rust">£2.50</span></li>
            </ul>
          </article>

          <article class="rounded-sm border border-ink/8 p-6">
            <h3 class="font-display text-lg font-bold text-ink">Granola & Yoghurt</h3>
            <p class="mt-3 text-sm">Granola & Greek Yoghurt Bowl with Fresh Fruit</p>
            <p class="mt-2 font-mono text-rust">£6.50</p>
          </article>
        </div>

        <div class="rounded-sm bg-rust p-6 text-center text-cream md:p-8">
          <p class="font-display text-2xl font-bold">Any Hot Drink & a Pastry — £5.00</p>
        </div>
      </div>

      <!-- LUNCH -->
      <div id="menu-lunch" class="menu-panel mt-10 space-y-10">
        <p class="font-mono text-xs uppercase tracking-widest text-rust">Served 11:30am–2:30pm</p>

        <div class="grid gap-6 md:grid-cols-2">
          <article class="rounded-sm border border-ink/8 bg-stone/50 p-6">
            <h3 class="font-display text-xl font-bold text-ink">Baguettes or Wraps</h3>
            <p class="mt-3 text-sm font-semibold">Cold Fillings <span class="font-mono text-rust">£5.85</span></p>
            <p class="mt-1 text-xs text-ink/60">Tuna Mayo, Cheese & Red Onion, Ham & Cheese, Coronation Chicken, Chicken Tikka</p>
            <p class="mt-4 text-sm font-semibold">Hot Fillings <span class="font-mono text-rust">£6.85</span></p>
            <p class="mt-1 text-xs text-ink/60">BBQ Chicken, Cajun Chicken, Chinese Chicken, Pesto Chicken, BBQ Pulled Pork, Beef Chilli</p>
          </article>

          <article class="rounded-sm border border-ink/8 bg-stone/50 p-6">
            <h3 class="font-display text-xl font-bold text-ink">Jacket Potatoes</h3>
            <ul class="mt-4 space-y-2 text-sm">
              <li class="flex justify-between"><span>Plain</span><span class="font-mono text-rust">£5.50</span></li>
              <li class="flex justify-between"><span>Cheese</span><span class="font-mono text-rust">£6.00</span></li>
              <li class="flex justify-between"><span>Cheese & Beans</span><span class="font-mono text-rust">£6.50</span></li>
              <li class="flex justify-between"><span>Any Cold Filling</span><span class="font-mono text-rust">£6.50</span></li>
              <li class="flex justify-between"><span>Any Hot Filling</span><span class="font-mono text-rust">£7.50</span></li>
            </ul>
          </article>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          <article class="rounded-sm border border-ink/8 p-6">
            <h3 class="font-display text-lg font-bold text-ink">Rice Bowl</h3>
            <ul class="mt-3 space-y-2 text-sm">
              <li class="flex justify-between"><span>1 meat</span><span class="font-mono text-rust">£8.25</span></li>
              <li class="flex justify-between"><span>2 meat</span><span class="font-mono text-rust">£10.25</span></li>
              <li class="flex justify-between"><span>3 meat</span><span class="font-mono text-rust">£12.00</span></li>
            </ul>
            <p class="mt-2 text-xs text-ink/55">Choose any hot/cold filling, add salad + sauce</p>
          </article>

          <article class="rounded-sm border border-ink/8 p-6">
            <h3 class="font-display text-lg font-bold text-ink">Hot Pasta Pots</h3>
            <ul class="mt-3 space-y-2 text-sm">
              <li class="flex justify-between"><span>Chicken Pesto Pasta</span><span class="font-mono text-rust">£8.00</span></li>
              <li class="flex justify-between"><span>Chicken Arrabbiata Pasta</span><span class="font-mono text-rust">£8.00</span></li>
              <li class="flex justify-between"><span>Vegetarian option available</span><span class="font-mono text-rust">£6.00</span></li>
            </ul>
            <p class="mt-2 text-xs text-ink/55">Optional Parmesan</p>
          </article>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          <article class="rounded-sm border border-ink/8 p-6">
            <h3 class="font-display text-lg font-bold text-ink">Sweet Jacket Potato Box</h3>
            <p class="text-xs text-ink/55">All served with couscous, coleslaw & salad</p>
            <ul class="mt-3 space-y-2 text-sm">
              <li class="flex justify-between"><span>No Meat</span><span class="font-mono text-rust">£7.00</span></li>
              <li class="flex justify-between"><span>1 Meat</span><span class="font-mono text-rust">£8.50</span></li>
              <li class="flex justify-between"><span>2 Meat</span><span class="font-mono text-rust">£10.50</span></li>
              <li class="flex justify-between"><span>3 Meat</span><span class="font-mono text-rust">£12.50</span></li>
            </ul>
          </article>

          <article class="rounded-sm border border-ink/8 p-6">
            <h3 class="font-display text-lg font-bold text-ink">Pizza Slice</h3>
            <ul class="mt-3 space-y-2 text-sm">
              <li class="flex justify-between"><span>Margherita</span><span class="font-mono text-rust">£3.50</span></li>
              <li class="flex justify-between"><span>Pepperoni</span><span class="font-mono text-rust">£4.00</span></li>
              <li class="flex justify-between"><span>BBQ Chicken</span><span class="font-mono text-rust">£4.50</span></li>
            </ul>
            <p class="mt-2 text-xs text-ink/55">Add optional extras</p>
          </article>

          <article class="rounded-sm border border-ink/8 p-6">
            <h3 class="font-display text-lg font-bold text-ink">Salad Box</h3>
            <p class="text-xs text-ink/55">All served with couscous, coleslaw & salad</p>
            <ul class="mt-3 space-y-2 text-sm">
              <li class="flex justify-between"><span>No Meat</span><span class="font-mono text-rust">£5.50</span></li>
              <li class="flex justify-between"><span>1 Meat</span><span class="font-mono text-rust">£7.00</span></li>
              <li class="flex justify-between"><span>2 Meat</span><span class="font-mono text-rust">£9.00</span></li>
              <li class="flex justify-between"><span>3 Meat</span><span class="font-mono text-rust">£11.00</span></li>
            </ul>
          </article>

          <article class="rounded-sm border border-ink/8 p-6">
            <h3 class="font-display text-lg font-bold text-ink">Sweet Treats</h3>
            <ul class="mt-3 space-y-2 text-sm">
              <li class="flex justify-between gap-4"><span>Homemade Oreo Cheesecake</span><span class="font-mono text-rust shrink-0">£4.50</span></li>
              <li class="flex justify-between gap-4"><span>Homemade Strawberry Cheesecake</span><span class="font-mono text-rust shrink-0">£4.50</span></li>
            </ul>
          </article>
        </div>
      </div>

      <!-- DRINKS -->
      <div id="menu-drinks" class="menu-panel mt-10 space-y-10">
        <p class="font-mono text-xs uppercase tracking-widest text-rust">Available all day</p>

        <div class="grid gap-6 md:grid-cols-2">
          <article class="rounded-sm border border-ink/8 bg-stone/50 p-6">
            <h3 class="font-display text-xl font-bold text-ink">Hot Drinks</h3>
            <p class="font-mono mt-3 text-xs text-rust">£3.50 each</p>
            <p class="mt-2 text-xs leading-relaxed text-ink/65">Latte, Cappuccino, Flat White, Mochaccino, Espresso, Americano, Hot Chocolate</p>
            <p class="mt-3 text-sm">Tea — <span class="font-mono text-rust">£3.00</span></p>
            <p class="mt-1 text-xs text-ink/55">Add a syrup — 50p each</p>
          </article>

          <article class="rounded-sm border border-ink/8 p-6">
            <h3 class="font-display text-lg font-bold text-ink">Iced Coffees</h3>
            <p class="font-mono mt-3 text-xs text-rust">£4.00 each</p>
            <p class="mt-2 text-xs text-ink/55">Add a syrup — 50p</p>
          </article>
        </div>

