<script>
  const promoMessages = [
    'Any Hot Drink & a Pastry — £5',
    'Jacket potatoes, salad boxes & pizza slices',
    'Order ahead — call 07904 709325',
  ];
  let promoIndex = 0;
  const promoEl = document.getElementById('promo-message');
  const hoursTodayEl = document.getElementById('hours-today');

  const hoursMap: Record<number, string> = {
    0: 'Closed today',
    1: 'Open today 7:30am–2:30pm',
    2: 'Open today 7:30am–2:30pm',
    3: 'Open today 7:30am–2:30pm',
    4: 'Open today 7:30am–2:30pm',
    5: 'Open today 7:30am–2:30pm',
    6: 'Open today 8:00am–4:00pm',
  };

  if (hoursTodayEl) {
    hoursTodayEl.textContent = hoursMap[new Date().getDay()];
  }

  setInterval(() => {
    promoIndex = (promoIndex + 1) % promoMessages.length;
    if (promoEl) {
      promoEl.innerHTML =
        promoIndex === 0
          ? 'Any Hot Drink & a Pastry — <span class="text-rust font-semibold">£5</span>'
          : promoMessages[promoIndex];
    }
  }, 4500);

  const nav = document.getElementById('site-nav');
  window.addEventListener('scroll', () => {
    if (!nav) return;
    nav.classList.toggle('nav-scrolled', window.scrollY > 40);
  });

  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');

  function toggleMobileMenu() {
    if (!mobileMenu) return;
    mobileMenu.classList.toggle('hidden');
    mobileMenu.classList.toggle('flex');
  }

  hamburger?.addEventListener('click', toggleMobileMenu);
  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      mobileMenu?.classList.remove('flex');
    });
  });

  function setMenuTab(tab: 'breakfast' | 'lunch' | 'drinks') {
    document.querySelectorAll('.menu-tab').forEach((btn) => {
      const isActive = btn.getAttribute('data-menu-tab') === tab;
      btn.classList.toggle('active', isActive);
      btn.classList.toggle('text-rust', isActive);
      btn.classList.toggle('border-rust', isActive);
      btn.classList.toggle('text-ink/50', !isActive);
    });
    document.querySelectorAll('.menu-panel').forEach((panel) => {
      panel.classList.toggle('active', panel.id === `menu-${tab}`);
    });
  }

  document.querySelectorAll('[data-menu-tab]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-menu-tab') as 'breakfast' | 'lunch' | 'drinks';
      setMenuTab(tab);
    });
  });

  document.querySelectorAll('.menu-nav-tab').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      setMenuTab('breakfast');
      document.getElementById('menu')?.scrollIntoView({ behavior: 'smooth' });
      mobileMenu?.classList.add('hidden');
      mobileMenu?.classList.remove('flex');
    });
  });

  if (window.location.hash === '#breakfast') setMenuTab('breakfast');

  const galleryUrls: string[] = [];
  document.querySelectorAll<HTMLButtonElement>('.gallery-trigger img').forEach((img) => {
    galleryUrls.push(img.currentSrc || img.src);
  });

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;

  document.querySelectorAll('.gallery-trigger').forEach((btn, i) => {
    btn.addEventListener('click', () => {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = galleryUrls[i] ?? '';
      lightboxImg.alt = btn.querySelector('img')?.alt ?? '';
      lightbox.classList.add('open');
    });
  });

  document.getElementById('lightbox-close')?.addEventListener('click', () => {
    lightbox?.classList.remove('open');
  });

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.classList.remove('open');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') lightbox?.classList.remove('open');
  });
</script>

<script type="module">
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const lenis = window.__lenis;
  if (lenis) {
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);
  }

  gsap.set('#hero-logo', { opacity: 0, y: 20 });
  gsap.set('#hero-headline', { opacity: 0, y: 40 });
  gsap.set('#hero-sub', { opacity: 0, y: 24 });
  gsap.set('#hero-cta', { opacity: 0, y: 20 });
  gsap.set('#hero-image', { opacity: 0, scale: 0.92 });

  const heroTl = gsap.timeline({ delay: 0.15 });
  heroTl
    .to('#hero-logo', { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out' })
    .to('#hero-headline', { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' }, '-=0.45')
    .to('#hero-sub', { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out' }, '-=0.5')
    .to('#hero-cta', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.45')
    .to('#hero-image', { opacity: 1, scale: 1, duration: 1, ease: 'power3.out' }, '-=0.65');

  gsap.utils.toArray<HTMLElement>('.section-reveal').forEach((section) => {
    gsap.fromTo(
      section,
      { y: 50, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.9,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: section,
          start: 'top 88%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  gsap.utils.toArray<HTMLElement>('.reveal-card').forEach((card, i) => {
    gsap.fromTo(
      card,
      { y: 36, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.8,
        delay: i * 0.08,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: card,
          start: 'top 92%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  gsap.utils.toArray<HTMLElement>('.gallery-item').forEach((item, i) => {
    gsap.fromTo(
      item,
      { y: 40, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.75,
        delay: (i % 3) * 0.1,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: item,
          start: 'top 92%',
          toggleActions: 'play none none none',
        },
      }
    );
  });

  gsap.utils.toArray<HTMLElement>('.signature-callout').forEach((el, i) => {
    gsap.to(el, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      delay: i * 0.12,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: '#signature',
        start: 'top 70%',
        toggleActions: 'play none none none',
      },
    });
  });

  gsap.utils.toArray<HTMLElement>('.stat-counter').forEach((item) => {
    const numEl = item.querySelector('.count-num');
    if (!numEl) return;

    const display = item.getAttribute('data-display');
    const target = parseFloat(item.getAttribute('data-target') || '0');
    const decimals = parseInt(item.getAttribute('data-decimals') || '0', 10);

    ScrollTrigger.create({
      trigger: item,
      start: 'top 90%',
      once: true,
      onEnter: () => {
        if (display) {
          numEl.textContent = display;
          return;
        }

        const counter = { val: 0 };
        gsap.to(counter, {
          val: target,
          duration: 1.4,
          ease: 'power2.out',
          onUpdate: () => {
            numEl.textContent =
              decimals > 0 ? counter.val.toFixed(decimals) : String(Math.round(counter.val));
          },
        });
      },
    });
  });
</script>

