---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={[
    'inline-flex items-center justify-center rounded-md border border-cream px-3 py-1.5',
    className,
  ]}
  aria-label="Jaggerz Takeaway"
>
  <div class="flex flex-col items-center leading-none">
    <span class="font-display text-[15px] font-bold tracking-[0.04em] text-cream">JAGGERZ</span>
    <span class="mt-1 font-body text-[7px] font-medium uppercase tracking-[0.32em] text-cream">Takeaway</span>
  </div>
</div>
